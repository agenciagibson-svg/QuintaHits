# URL pública do site (metadata, OpenGraph, sitemap)
NEXT_PUBLIC_SITE_URL=https://quinta-hits.vercel.app
# Link externo de reserva de mesa. Vazio = o botão leva ao mapa de mesas do site (/reservar)
NEXT_PUBLIC_RESERVA_URL=

# Painel admin (/admin) — server-side apenas. Preencher também na Vercel.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# E-mails (separados por vírgula) que podem entrar no painel. A senha é a do usuário no Supabase Auth.
ADMIN_EMAILS=agenciagibson@gmail.com
# Segredo aleatório (32+ caracteres) que assina o cookie de login. Nunca reutilize a senha.
ADMIN_SESSION_SECRET=

# Reserva de mesa — "não sou robô" (Cloudflare Turnstile, gratuito): dash.cloudflare.com → Turnstile → Add widget.
# Sem a secret em produção, as reservas pelo site ficam bloqueadas.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Reserva de mesa — confirmação automática pelo WhatsApp (WhatsApp Cloud API da Meta). Passo a passo no README.
# Número que recebe as confirmações, só dígitos com 55 (ex.: 5534999998888). Sem ele, reserva pelo site fica desligada.
WHATSAPP_NUMERO_CASA=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
# Texto livre que você inventa e repete no cadastro do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=

# ===== CHAVES DE SEGURANÇA (todas nascem DESLIGADAS) =====
# Só o texto EXATO "true" liga; vazio, ausente ou qualquer outro valor = desligada. Ter as credenciais acima preenchidas
# NUNCA liga nada: cada funcionalidade tem a sua chave. Mudar exige novo deploy. O painel (/admin) mostra o estado de todas.
# Agente de atendimento do WhatsApp.
WHATSAPP_AGENT_ENABLED=false
# Envio de mensagens. O envio REAL exige WHATSAPP_AGENT_ENABLED=true E WHATSAPP_SEND_ENABLED=true ao mesmo tempo.
WHATSAPP_SEND_ENABLED=false
# Registro do número na Meta: só o script manual scripts/registrar-numero.mjs usa (com confirmação interativa). Não ligue no deploy.
WHATSAPP_REGISTRATION_ENABLED=false
# Reserva de mesa pelo site (formulário e API). Exige também as credenciais e o envio real, e edições liberadas no painel.
RESERVAS_SITE_ENABLED=false
# Limpeza real de dados antigos (sem ela a rotina só simula).
# RETENCAO_ENABLED=false
# Segredo (16+ caracteres) da tarefa agendada /api/cron/retencao. Sem ele a rota fica desligada. Gere um valor aleatório; nunca no chat.
# CRON_SECRET=
