# QUINTA HITS — variáveis do ambiente de HOMOLOGAÇÃO (só nomes e exemplos inofensivos).
# Copie para `.env.local` (ou cadastre num projeto Vercel de homologação SEPARADO do de produção).
# Nunca reaproveite aqui uma chave, URL ou segredo de produção. `.env*.local` não vai para o git.

# Trava contra misturar ambientes: precisa ser IGUAL a wa_config.ambiente do banco ('homologacao' aqui,
# 'producao' na Vercel de produção). Se divergir, o agente fica desligado.
APP_AMBIENTE=homologacao

# --- Supabase de HOMOLOGAÇÃO (projeto separado do de produção) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Painel /admin (use um e-mail e um segredo próprios da homologação) ---
ADMIN_EMAILS=
# 32+ caracteres aleatórios, DIFERENTE do de produção.
ADMIN_SESSION_SECRET=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- "Não sou robô": chaves oficiais de TESTE da Cloudflare (sempre aprovam; conferir na documentação do Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- WhatsApp Cloud API ---
# Ficam vazios até o registro do número ser autorizado. Token e segredo: só no painel da Vercel ou em .env.local.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_NUMERO_CASA=
WHATSAPP_WABA_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
META_GRAPH_API_VERSION=
META_APP_ID=
META_APP_SECRET_PROOF_ENABLED=true

# --- Interruptores do agente: TUDO DESLIGADO durante a implementação e a homologação ---
WHATSAPP_AGENT_ENABLED=false
WHATSAPP_SEND_ENABLED=false
WHATSAPP_HUMAN_HANDOFF_ENABLED=true
# O PIN de registro do número NÃO é variável de ambiente: é digitado no terminal, com entrada oculta.
